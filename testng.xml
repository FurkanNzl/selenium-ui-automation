<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- This file defines which tests run and in what order.
     When you add a new test class, remember to add its <class> line here. -->
<suite name="SauceDemo UI Test Suite" verbose="1">

    <test name="Login Tests">
        <classes>
            <class name="com.furkan.saucedemo.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Products and Cart Tests">
        <classes>
            <class name="com.furkan.saucedemo.tests.ProductsCartTest"/>
        </classes>
    </test>

    <test name="End-to-End Checkout Test">
        <classes>
            <class name="com.furkan.saucedemo.tests.CheckoutE2ETest"/>
        </classes>
    </test>

</suite>
